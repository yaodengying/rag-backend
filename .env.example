# =============================================================================
# rag-backend 环境变量模板
#
# 用法：复制为 .env 后按本机情况修改。.env 已在 .gitignore 中，切勿提交。
# 所有变量均对应 app/core/config.py 中 Settings 的同名字段（大小写不敏感）。
#
# 哪些必须填：
#   app/core/config.py 中「与机器/后端相关」的字段默认值为空，不填则服务
#   启动时会被 validate_runtime() 拦下并逐条报出问题。具体是——
#     LLM_BASE_URL、LLM_MODEL、EMBEDDING_MODEL_PATH、AUTH_SECRET_KEY，以及
#     RERANK_ENABLED=true 时的 RERANK_MODEL_PATH。
#   其余字段都有可用默认值，本文件只是把它们显式写出来便于查阅。
# =============================================================================

# ---------- 应用 ----------
APP_NAME=rag-backend
APP_ENV=local
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO
# 逗号分隔的前端来源，供 CORS 使用
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Milvus ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 是否启用 Milvus 鉴权（本地 standalone 默认关闭）
MILVUS_USER=
MILVUS_PASSWORD=
# 本机 Milvus 已存在同名但 schema 不同的早期集合（rag_chunks），故用独立名
MILVUS_COLLECTION=rag_backend_chunks
# **声明值**：真实维度取自 embedding 权重目录 config.json 的 hidden_size
# （bge-large-zh-v1.5 = 1024）。这里写的值只做交叉校验——不一致时服务
# 启动就会失败并告诉你该改成多少，不会出现「按旧维度建表、按新维度写入」。
MILVUS_DIMENSION=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=AUTOINDEX

# 单次写入 Milvus 的片段条数。分批写入的原因见 docs/architecture.md 5.1：
# 请求体与峰值内存随文档规模线性增长（1024 维 float32 每条约 4 KB），
# 且分批后长文档的入库才有条数可报的进度。代码侧硬上限 2000。
MILVUS_UPSERT_BATCH_SIZE=500

# ---------- Embedding（本地 BGE 权重目录，不走 Ollama）----------
# 【必填】FlagEmbedding 能直接加载的**权重目录**（含 config.json）。
# 注意：Ollama 的 manifests 目录不是可加载的权重目录，别指过去。
# 例如：H:\models\bge-large-zh-v1.5  → 输出 1024 维，与 MILVUS_DIMENSION 一致
EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu
# BGE 中文检索指令：只加在 query 前，文档块不加
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
EMBEDDING_BATCH_SIZE=32
# 启用离线模式，避免 transformers 联网卡住（国内网络建议保持 1）
HF_HUB_OFFLINE=1

# ---------- Reranker（本地 BGE 交叉编码器）----------
RERANK_ENABLED=true
# 【必填，RERANK_ENABLED=true 时】例如：H:\models\bge-reranker-base
RERANK_MODEL_PATH=
RERANK_DEVICE=cpu
RERANK_TOP_N=4
# 分数尺度有两种，务必明确：FlagReranker.compute_score() 的 normalize 默认 False，
# 返回**原始 logits**（可为负）；传 normalize=True 才套 Sigmoid 落到 [0,1]。
# 本阈值按「原始 logits」尺度设，0.0 即可干净区分正负样本。
RERANK_MIN_SCORE=0.0

# ---------- LLM（OpenAI 兼容协议）----------
# 【必填】端点与模型名。下面给的是本机 Ollama 的示例值，按你的后端改：
#   Ollama   → http://127.0.0.1:11434/v1
#   vLLM     → http://127.0.0.1:8000/v1
#   LM Studio→ http://127.0.0.1:1234/v1
#   云服务   → 各家自己的地址，并把 LLM_API_KEY 填上
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2:7b
# 本地后端不校验密钥，可留空（客户端会用占位串）；云服务必须填
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
# 输出预留（skill 里的 R）：既作为输出上限下发给模型，也从上下文预算里
# 先扣掉。不设它，答案被后端截断时系统完全不知情（只有空串会被判成异常）。
LLM_MAX_TOKENS=2048
# 输出上限在请求体里的字段名。为什么可配：langchain-openai 1.7 会把
# max_tokens 参数改写成 max_completion_tokens，而 Ollama / vLLM 只认
# max_tokens——实测 Ollama 0.40.5 对 max_completion_tokens 完全无视
# （限制 8 token 却输出 477，finish_reason 仍是 stop），输出预留等于没设。
# 本地后端保持 max_tokens；OpenAI 云端较新模型改成 max_completion_tokens。
LLM_MAX_TOKENS_FIELD=max_tokens

# ---------- 上下文预算（app/rag/budget.py）----------
# **实际服务窗口**，不是界面/文档里的声明值：Ollama 填 num_ctx，
# vLLM 填 --max-model-len。填大了提示词会超窗、被后端静默截断。
# 部署后必须核对一次：python scripts/check_context_window.py --load
# （Ollama 的 /api/ps 会给出运行时真实的 context_length；不一致时会打印改法）
LLM_CONTEXT_WINDOW=4096
# 证据占"窗口-输出预留-固定开销"的比例。小窗口 4k~16k 取 0.4~0.45，大窗口可到 0.6
CONTEXT_EVIDENCE_SHARE=0.5
# 安全余量（占剩余预算的比例），给 tokenizer 近似与模板差异兜底
CONTEXT_MARGIN_RATIO=0.05
# 每条证据的元数据开销（"[n] 来源：文件名 第N页"），20~40 token 量级
CONTEXT_META_TOKENS=24
# 单条证据参与预算的最大字符数；必须与 prompts.format_context 的截断一致
CONTEXT_SNIPPET_LIMIT=1200
# 证据条数上限（skill 的 k_cap：单点事实 3~4、解释 6~8、对比 8~10，默认 12）。
# 预算够不代表该塞满：长上下文正中间的证据会被忽略，成本却按条线性涨。
CONTEXT_MAX_EVIDENCE=12
# token 计数：auto（本地 tokenizer → tiktoken → 字符估算）/ tokenizer / tiktoken / chars
# 字符估算误差可达 30%，只应作为兜底；离线环境可设 chars 避免首次请求等待
TOKEN_ESTIMATOR=auto
# 本地 tokenizer 目录（应与 LLM_MODEL 同源）；留空则 auto 走 tiktoken
# TOKENIZER_PATH=
# 字符估算的换算系数：中文一 token 约 1.2~1.5 字，取 1.2 是刻意高估 token
CHARS_PER_TOKEN=1.2

# ---------- 检索 ----------
# 每路召回的深度（向量路与 BM25 路各取这么多条），也是送进重排的候选数
RETRIEVE_TOP_K=8
# 召回深度模式：fixed = 固定取 RETRIEVE_TOP_K 条（默认，与历史行为一致）；
# adaptive = 先取 min(top_k, RETRIEVE_K_MAX) 条，再按每路分数的**断层**截到
# [RETRIEVE_K_MIN, 上限]。开启前先跑 scripts/tune_retrieval.py 看分数分布，
# 并重跑评估——README 里的 MRR 数字是在固定 k 上量出来的。
RETRIEVE_K_MODE=fixed
# adaptive 的下限：宁可多留几条，也不要因为一条断崖切到只剩 1 条
RETRIEVE_K_MIN=4
# adaptive 的上限（同时是过采样条数）。它**不放大** top_k，实际取
# min(top_k, 此值)；想让动态范围摸到 16，请把 RETRIEVE_TOP_K 设到 16
RETRIEVE_K_MAX=16
# 断层判据：相邻两条的落差 >= 该比例 × 本路最高分，才算"这里换主题了"。
# 余弦量级随查询变化（中文短查询整体 0.28~0.35），只能看相对落差；
# 0.25 是保守值，具体语料上应先看分数分布再定，别照抄
RETRIEVE_K_DROP_RATIO=0.25
# 混合检索开关。关闭时只跑向量路。
# 注意：**不影响 collection 的 schema** —— 稀疏字段与 BM25 索引始终会建。
# 否则"改一行配置就得重建 collection"，是个很容易踩的坑。
HYBRID_ENABLED=true
# RRF 平滑常数：越大越压平排名差距，越依赖"两路都出现"这个信号
HYBRID_RRF_K=60
# 两路权重。**只有比值有意义**：0.5/0.5 与 1/1 排序完全相同，
# 只是 fusion_score 的绝对值差一倍。两者不能同时为 0。
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5
# 余弦相似度下限，低于此值的片段不进入融合（只作用于向量路）。
# BM25 路**不设阈值**：BM25 分无界且随语料漂移，写死阈值换语料就失效。
#
# 注意这个值**只在纯向量模式（HYBRID_ENABLED=false）下生效**：
# 那时向量路是唯一通道，阈值是唯一的精度闸门。
MIN_SIMILARITY=0.35
# 混合模式（HYBRID_ENABLED=true）下稠密路的下限。默认 0.0 = 不设限。
# 为什么默认不设限：中文短查询对 300 字长块，余弦相似度本就只有 0.28~0.35
# （实测「多久需要做一次检查？」0.29、「巡检」0.31、「XG-8800」0.31，
# 只有「设备的固件怎么升级」到 0.57），用 0.35 当门槛会把整条稠密路
# **静默清空**——而混合检索还会掩盖它：BM25 照常出结果，
# 从返回内容上看不出向量路一条都没召回，只有 debug=true 才暴露。
# 给融合的两路只设一边的阈值本身也不对称（BM25 无界、无法设阈值）。
# 调高请先看 scripts/check_retrieval.py 第 9 节的实测。
HYBRID_DENSE_MIN_SIMILARITY=0.0

# 稀疏路（BM25）的分数下限。默认 0.0 = 不过滤。
# 为什么默认不过滤：BM25 分**无界且随语料漂移**（同一句查询换一份语料，
# 分数整体尺度就变），写死绝对值换数据集即失效。
# 实测噪声形态：真命中 0.68，而只共享一个「的」的无关片段能到 0.55——
# 两者差得很少，设 0.6 会连真命中一起砍掉。所以默认交给下游交叉熵重排。
# 只有在"库很大、重排前候选被噪声挤爆"时才设，取值看
# scripts/tune_retrieval.py 打印的真实分位表。
HYBRID_BM25_MIN_SCORE=0.0
# 近重复合并：另存过的 PDF / 重新解析出的同一段正文，字节不同、文本近乎相同。
# 上传层的内容哈希拦不住，精确去重（文件名+正文）也拦不住（文件名可能变了）。
# 判据是字符三元组 Jaccard，且**数字/型号、否定词必须完全一致**——
# 「48 小时」与「24 小时」、「可以」与「不可以」、「应当」与「可以」都不是重复。
HYBRID_NEAR_DUPE_RATIO=0.95
# 参与近重复合并的最小正文长度（折叠空白后）。短文本不合并：
# 两篇文档引用同一句公告是合法的，只有成段复制才当作副本。
HYBRID_NEAR_DUPE_MIN_CHARS=60

# ---------- 问答（流式改写重试的服务端默认值）----------
# 请求体 enable_retry 是**三态**：
#   true / false → 前端用户的选择，服务端一定照办（显式 false 会压过这一项）；
#   省略 / null  → 落回下面这个默认值。
# 前端渲染「是否允许改写重试」开关时需要知道服务端的当前值，用
# GET /api/v1/chat/options 读取即可——**不要把默认值抄一份到前端**，
# 否则改一处忘一处时表现为「界面上开着、后端却没重试」，没有任何报错。
#   false = 首轮没找到就直接拒答（首帧时间优先，出厂值）
#   true  = 自动多花 2~4 秒改写一次查询再检索（本机 7B 实测）
# 注意：非流式 POST /chat **恒**重试一次，与本项无关。
CHAT_STREAM_RETRY_DEFAULT=false

# 生成之后的接地性核验动作：off / flag / block
#   off   不核验（只用于对照实验）
#   flag  只标记不改写：响应里带 grounding 报告，日志里打「回答接地性告警」
#   block 判定为 low 时把回答换成拒答话术（**仅非流式生效**）
# 默认 flag。改成 block 会推高拒答率（用户以为库里没有这条），
# 属产品取舍：开之前先看 docs/anti-hallucination.md，并在评估集上对比拒答率。
GROUNDING_ACTION=flag

# 整批最高分闸门：重排后最高分低于它 → 整批视为「没找到」。
# 0 = 关闭（默认）。开放之前必须先用 scripts/probe_rerank_gap.py 在**你的语料**
# 上量「可答题最低分」与「硬负样本最高分」有没有间隔——logits 尺度随模型/语料漂，
# 照抄别人的数字会误杀。本机实测：正样本最低 1.797，负样本最高 1.048。
RERANK_MIN_TOP_SCORE=0.0

# ---------- 切分 ----------
# 中文文档建议 150~300；过大会导致长块的 Jaccard/相似度被稀释
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ---------- 上传与落盘 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
# 扩展名白名单（逗号分隔）。不含 .doc —— python-docx 只能读 OOXML 的 .docx，
# 旧版二进制 .doc 会被明确拒绝，比放进来再抛难懂的异常要好。
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.pptx

# 批量上传的两个总闸门：单文件上限挡不住"20 个 49MB 文件"。
MAX_BATCH_FILES=20
MAX_BATCH_TOTAL_MB=200

# 上传内容的静态检查（魔数 / 压缩炸弹 / 二进制伪装）。
# MAX_ZIP_RATIO 带 1MB 下限：重复度高的正常 docx 压缩比可达 346:1，
# 只看比例会误杀；危险的是"比例高**且**解压后很大"。0 = 关闭比例检查。
MAX_PDF_PAGES=3000
MAX_ZIP_ENTRIES=5000
MAX_ZIP_UNCOMPRESSED_MB=300
MAX_ZIP_RATIO=200

# 入库并发：向量化是纯 CPU 的批量前向，并行不会更快，只会让尾延迟一起变差。
# 1 = 排队。要横向扩展请多开**检索**，入库保持单写。
INGEST_MAX_CONCURRENCY=1

# ---------- 元数据持久化（SQLite）----------
SQLITE_PATH=./data/rag.db

# ---------- 认证 ----------
# 【必填】令牌签名密钥。留空或短于 32 字符会被 validate_runtime() 拦下。
# 生成方式（不要手敲）：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：这是"这次部署的事实"，每套环境各自一份；写进代码或提交进仓库
# 等于把伪造令牌的能力交给所有看到仓库的人。
AUTH_SECRET_KEY=
# 令牌有效期（分钟）。默认 720 = 12 小时，够覆盖一个工作日。
# 本项目没有续期机制，过期即重新登录（登录只算一次 PBKDF2，成本可接受）。
AUTH_TOKEN_TTL_MINUTES=720
# 是否开放 POST /api/v1/auth/register。
#   本地开发 true：方便自测；对外环境 false：改用 scripts/create_user.py 建号。
# APP_ENV=prod 且此项为 true 时，服务会拒绝启动。
AUTH_ALLOW_REGISTRATION=true
# 新口令的 PBKDF2 迭代次数（下限 100000，由 validate_runtime 把关）。
# 只影响此后新设的口令：校验已有口令用的是哈希串里记录的次数，
# 所以调整这个值不会让已注册的账号登不进来。
AUTH_PBKDF2_ITERATIONS=210000

# ---------- 代理（本机若配置了全局 http_proxy，必须放行 localhost）----------
# pymilvus 走 gRPC，会被 HTTP 代理拦成 502
NO_PROXY=localhost,127.0.0.1

# ---------- 仅容器化运行需要（deploy/docker-compose.yml 读取）----------
# 应用本身不读这一项（Settings 会忽略未知字段），留给容器编排用。
# 原因：容器内的 127.0.0.1 是容器自己，访问宿主机上的 Ollama 必须换主机名，
# 所以不能直接复用上面的 LLM_BASE_URL。
# 用法：docker compose -f deploy/docker-compose.yml --env-file .env up -d
LLM_BASE_URL_HOST=http://host.docker.internal:11434/v1

# ---------- 会话（多轮对话历史，Redis） ----------
# 多轮对话历史的存储；留空时会话接口报 503、问答照常但不落库。
# Redis 存的是按会话聚合的消息序列（带 TTL，默认 7 天，见 CONVERSATION_TTL_HOURS）。
# REDIS_URL=redis://127.0.0.1:6379/0
# 会话过期时间（小时）；每次问答自动续期
# CONVERSATION_TTL_HOURS=168
# 问答时送进提示词的最近消息条数上限（0 = 历史只落库不进提示词）
# CONVERSATION_HISTORY_TURNS=6

# ---------- 链路追踪（LangSmith，可选）----------
# 整段默认关闭：不填 LANGSMITH_API_KEY 就什么都不发生。
# langsmith SDK 已随 langchain-core 装好，**无需额外 pip install**。
#
# 能看到的：一次问答的完整链路 —— retrieve / rerank 各自的耗时与召回条数、
#           流式生成的首字延迟与 token 数、改写重试有没有触发、哪一步报错。
#           /chat（非流式）与 /chat/stream（流式）都有完整 trace。
#
# 开启步骤：
#   1. 到 https://smith.langchain.com 建 project，取 API Key（形如 lsv2_...）
#   2. 取消下面两行的注释并填 key
#   3. **必须同时确认隐私开关为 true**（见下），再重启后端
#
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=rag-backend
#
# 自建 / 欧洲区端点才需要改；留空走官方 https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=
#
# 【隐私闸门】默认隐藏，**建议保持 true**。
#   提示词里含用户上传的文档正文与多轮历史（见 app/rag/prompts.py），
#   默认上报等于替你把文档内容发到第三方平台。
#   隐藏后只能看到节点拓扑、耗时、状态、token 数、报错，看不到正文；
#   本地排查幻觉/提示词问题时可以临时设 false，排查完记得改回来。
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# 上报失败时是否打日志。建议保持 true —— 追踪静默失效最难发现：
# 你会以为"这几天没出问题"，其实是根本没在记录。
LANGSMITH_LOG_ERRORS=true
#
# 【国内网络注意】访问 api.smith.langchain.com 需要代理。
#   本机已有全局代理时无需额外配置；若 trace 一直 403/超时，
#   先确认代理是否覆盖 443 出网，再检查 key 是否有效。
#   NO_PROXY 里只有 localhost/127.0.0.1，不影响 LangSmith 走代理。
